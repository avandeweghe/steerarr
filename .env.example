# Steerarr server configuration. All optional: the defaults work.
# Copy to .env to change them. .env is git-ignored: never commit it.
#
# Services (Sonarr, ...) are set up in the app itself, not here.

# Port the server listens on inside the container (the dev compose file pins it to 6232).
PORT=6232
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Which proxies may set X-Forwarded-* headers. Comma-separated IPs/CIDRs and/or the
# names loopback, linklocal, uniquelocal. Also accepts true / false.
TRUST_PROXY=loopback,linklocal,uniquelocal
# Folder where Steerarr saves its data, such as the service settings entered in the app.
# Mount a volume here. The dev compose file pins it to /data.
DATA_DIR=/data

# --- Dev only --------------------------------------------------------------
# Set to true when running the dev stack on Docker Desktop for Windows, where file
# changes on C:\ don't reach the container as events, so Vite has to poll.
VITE_USE_POLLING=false
